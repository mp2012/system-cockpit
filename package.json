{
  "name": "system-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform desktop system monitor",
  "author": "System Cockpit",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test:smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.systemcockpit.desktop",
    "productName": "System Cockpit",
    "asar": true,
    "files": [
      "electron/**/*",
      "ç³»ç»Ÿæ•°æ®é©¾é©¶èˆ±.html",
      "echarts.min.js",
      "fonts/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}